 src/libobmm/libobmm_log.h    |  75 ++++++++++++++++++
 src/libobmm/vendor_adaptor.c |  33 ++++----
 3 files changed, 220 insertions(+), 38 deletions(-)
 create mode 100644 src/libobmm/libobmm_log.h

