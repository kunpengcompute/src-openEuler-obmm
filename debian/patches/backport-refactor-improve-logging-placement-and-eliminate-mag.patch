         return ret;
     }
-    OBMM_LOG_SUCCESS("numa_id=%d pa=%llx", preimport_info->numa_id, (unsigned long long)preimport_info->pa);
+    OBMM_LOG_SUCCESS("numa_id=%d pa=%#lx", preimport_info->numa_id, preimport_info->pa);
     return 0;
 }
