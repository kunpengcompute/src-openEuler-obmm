From 13a160309e27b53d3b78d4e9d24d005bd03084e7 Mon Sep 17 00:00:00 2001
From: Li Ruilin <liruilin4@huawei.com>
Date: Thu, 5 Mar 2026 20:28:02 +0800
Subject: [PATCH 16/18] refactor: implement automatic version management for
 VERSION and SOVERSION

- Add automatic version management in CMakeLists.txt
- Add VERSION_FILE_PATH variable to manage version file location
- Read version from VERSION file using relative path
- Parse version string into major, minor, and patch components
- Automatically set SOVERSION to major version
- Create VERSION file with current version 1.0.1

This implementation ensures consistent versioning across the codebase and simplifies version management by maintaining version information in a single file.
---
 VERSION                    |  1 +
 src/libobmm/CMakeLists.txt | 15 +++++++++++++++
 2 files changed, 16 insertions(+)
 create mode 100644 VERSION

diff --git a/VERSION b/VERSION
new file mode 100644
index 0000000..7dea76e
--- /dev/null
+++ b/VERSION
@@ -0,0 +1 @@
+1.0.1
diff --git a/src/libobmm/CMakeLists.txt b/src/libobmm/CMakeLists.txt
index 3932217..ef522b2 100644
--- a/src/libobmm/CMakeLists.txt
+++ b/src/libobmm/CMakeLists.txt
@@ -2,6 +2,21 @@ cmake_minimum_required(VERSION 3.10)
 
 project(OBMM_SO C)
 
+# Define version file path
+set(VERSION_FILE_PATH ${CMAKE_CURRENT_LIST_DIR}/../../VERSION)
+
+# Read version from VERSION file
+file(READ ${VERSION_FILE_PATH} OBMM_VERSION)
+string(STRIP ${OBMM_VERSION} OBMM_VERSION)
+
+# Parse version into major, minor, patch
+string(REGEX REPLACE "([0-9]+)\.([0-9]+)\.([0-9]+)" "\\1" OBMM_VERSION_MAJOR ${OBMM_VERSION})
+string(REGEX REPLACE "([0-9]+)\.([0-9]+)\.([0-9]+)" "\\2" OBMM_VERSION_MINOR ${OBMM_VERSION})
+string(REGEX REPLACE "([0-9]+)\.([0-9]+)\.([0-9]+)" "\\3" OBMM_VERSION_PATCH ${OBMM_VERSION})
+
+# Set SOVERSION to major version (common practice for library versioning)
+set(OBMM_SOVERSION ${OBMM_VERSION_MAJOR})
+
 aux_source_directory(${CMAKE_CURRENT_LIST_DIR} LIBOBMM_DIR_SRCS)
 add_library(OBMM_SO SHARED ${LIBOBMM_DIR_SRCS})
 target_link_libraries(OBMM_SO PRIVATE)
